@page "/tasks"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@attribute [Authorize]
@inject ITaskService TaskService
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Tasks - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>My Tasks</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateTaskModal">
                <i class="bi bi-plus-circle"></i> New Task
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-md-3">
            <label>Status</label>
            <select class="form-select" @bind="filterStatus">
                <option value="">All</option>
                <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                <option value="@Models.TaskStatus.InProgress">In Progress</option>
                <option value="@Models.TaskStatus.Completed">Completed</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>Priority</label>
            <select class="form-select" @bind="filterPriority">
                <option value="">All</option>
                <option value="@TaskPriority.Low">Low</option>
                <option value="@TaskPriority.Medium">Medium</option>
                <option value="@TaskPriority.High">High</option>
                <option value="@TaskPriority.Critical">Critical</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>&nbsp;</label>
            <button class="btn btn-secondary d-block w-100" @onclick="ApplyFilters">
                Apply Filters
            </button>
        </div>
    </div>

    <!-- Tasks List -->
    @if (tasks == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!tasks.Any())
    {
        <div class="alert alert-info">No tasks found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Due Date</th>
                        <th>Project</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr>
                            <td>
                                <strong>@task.Title</strong>
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <br />
                                    <small class="text-muted">@task.Description</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@GetPriorityColor(task.Priority)">
                                    @task.Priority
                                </span>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" 
                                        value="@task.Status" 
                                        @onchange="@(e => UpdateTaskStatus(task.TaskId, Enum.Parse<Models.TaskStatus>(e.Value?.ToString() ?? "NotStarted")))">
                                    <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                                    <option value="@Models.TaskStatus.InProgress">In Progress</option>
                                    <option value="@Models.TaskStatus.Completed">Completed</option>
                                </select>
                            </td>
                            <td>
                                @if (task.DueDate.HasValue)
                                {
                                    var isOverdue = task.DueDate.Value < DateTime.UtcNow && task.Status != Models.TaskStatus.Completed;
                                    <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                        @task.DueDate.Value.ToString("MMM dd, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No due date</span>
                                }
                            </td>
                            <td>
                                @if (task.Project != null)
                                {
                                    <a href="/projects/@task.ProjectId">@task.Project.Name</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewTaskDetails(task.TaskId)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenDocumentsPanel(task)">
                                    <i class="bi bi-paperclip"></i> Documents
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (selectedTaskForDocuments != null)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Documents for "@selectedTaskForDocuments.Title"</h5>
                    <button type="button" class="btn-close" @onclick="CloseDocumentsPanel"></button>
                </div>
                <div class="modal-body">
                    @if (selectedTaskForDocuments.ProjectId == null)
                    {
                        <div class="alert alert-info">This task has no project; uploaded documents will be personal files.</div>
                    }

                    <h6>Project Documents</h6>
                    @if (taskProjectDocuments == null || !taskProjectDocuments.Any())
                    {
                        <p class="text-muted">No documents associated with this task's project yet.</p>
                    }
                    else
                    {
                        <ul class="list-group mb-3">
                            @foreach (var document in taskProjectDocuments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @document.Title
                                    @if (document.ScanStatus == DocumentScanStatuses.Available)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="/documents/download/@document.DocumentId" target="_blank">
                                            <i class="bi bi-download"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Scanning</span>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    <hr />
                    <h6>Upload a New Document</h6>
                    @if (!string.IsNullOrEmpty(docUploadError))
                    {
                        <div class="alert alert-danger">@docUploadError</div>
                    }
                    <div class="row g-2 mb-3">
                        <div class="col-md-5">
                            <input class="form-control" placeholder="Title" @bind="docUploadTitle" />
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" @bind="docUploadCategory">
                                @foreach (var category in DocumentCategories.All)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <InputFile class="form-control" OnChange="OnDocUploadFileSelected" />
                        </div>
                    </div>
                    <button class="btn btn-primary mb-4" disabled="@isDocUploading" @onclick="UploadTaskDocumentAsync">
                        @(isDocUploading ? "Uploading..." : "Upload")
                    </button>

                    @if (selectedTaskForDocuments.ProjectId != null)
                    {
                        <hr />
                        <h6>Attach an Existing Personal Document</h6>
                        @if (!string.IsNullOrEmpty(attachError))
                        {
                            <div class="alert alert-danger">@attachError</div>
                        }
                        @if (myPersonalDocuments == null || !myPersonalDocuments.Any())
                        {
                            <p class="text-muted">You have no personal documents available to attach.</p>
                        }
                        else
                        {
                            <div class="input-group">
                                <select class="form-select" @bind="attachDocumentId">
                                    <option value="">-- Select document --</option>
                                    @foreach (var document in myPersonalDocuments)
                                    {
                                        <option value="@document.DocumentId">@document.Title</option>
                                    }
                                </select>
                                <button class="btn btn-outline-primary" @onclick="AttachExistingDocumentAsync">Attach</button>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDocumentsPanel">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TaskItem>? tasks;
    private string filterStatus = "";
    private string filterPriority = "";
    private int currentUserId = 0;

    private TaskItem? selectedTaskForDocuments;
    private List<Document>? taskProjectDocuments;
    private List<Document>? myPersonalDocuments;
    private string docUploadTitle = "";
    private string docUploadCategory = DocumentCategories.Other;
    private IBrowserFile? docUploadFile;
    private string? docUploadError;
    private bool isDocUploading;
    private int? attachDocumentId;
    private string? attachError;

    protected override async Task OnInitializedAsync()
    {
        // Get current user ID from authentication claims
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            await LoadTasks();
        }
    }

    private async Task LoadTasks()
    {
        tasks = await TaskService.GetUserTasksAsync(currentUserId);
    }

    private async Task ApplyFilters()
    {
        Models.TaskStatus? status = string.IsNullOrEmpty(filterStatus) ? null : Enum.Parse<Models.TaskStatus>(filterStatus);
        TaskPriority? priority = string.IsNullOrEmpty(filterPriority) ? null : Enum.Parse<TaskPriority>(filterPriority);

        tasks = await TaskService.GetFilteredTasksAsync(currentUserId, status, priority, null);
    }

    private async Task UpdateTaskStatus(int taskId, Models.TaskStatus newStatus)
    {
        if (currentUserId > 0)
        {
            await TaskService.UpdateTaskStatusAsync(taskId, currentUserId, newStatus);
            await LoadTasks();
        }
    }

    private void ShowCreateTaskModal()
    {
        // TODO: Implement modal dialog for creating tasks
    }

    private void ViewTaskDetails(int taskId)
    {
        // TODO: Navigate to task details or show modal
    }

    private async Task OpenDocumentsPanel(TaskItem task)
    {
        selectedTaskForDocuments = task;
        docUploadError = null;
        attachError = null;
        attachDocumentId = null;
        docUploadTitle = "";
        docUploadFile = null;

        taskProjectDocuments = task.ProjectId.HasValue
            ? await DocumentService.GetProjectDocumentsAsync(task.ProjectId.Value, currentUserId)
            : new List<Document>();

        var myDocuments = await DocumentService.GetMyDocumentsAsync(currentUserId);
        myPersonalDocuments = myDocuments.Where(d => d.ProjectId == null).ToList();
    }

    private void CloseDocumentsPanel()
    {
        selectedTaskForDocuments = null;
    }

    private void OnDocUploadFileSelected(InputFileChangeEventArgs e)
    {
        docUploadFile = e.File;
    }

    private async Task UploadTaskDocumentAsync()
    {
        if (selectedTaskForDocuments == null)
        {
            return;
        }

        if (docUploadFile == null)
        {
            docUploadError = "Please choose a file.";
            return;
        }

        if (string.IsNullOrWhiteSpace(docUploadTitle))
        {
            docUploadError = "Title is required.";
            return;
        }

        isDocUploading = true;
        docUploadError = null;
        try
        {
            const long maxUploadBytes = 25 * 1024 * 1024;
            await using var browserStream = docUploadFile.OpenReadStream(maxUploadBytes);
            using var buffer = new MemoryStream();
            await browserStream.CopyToAsync(buffer);
            buffer.Position = 0;

            var request = new UploadDocumentRequest
            {
                Title = docUploadTitle,
                Category = docUploadCategory,
                ProjectId = selectedTaskForDocuments.ProjectId,
                FileStream = buffer,
                OriginalFileName = docUploadFile.Name,
                ContentType = string.IsNullOrWhiteSpace(docUploadFile.ContentType) ? "application/octet-stream" : docUploadFile.ContentType,
                FileSizeBytes = docUploadFile.Size
            };

            await DocumentService.UploadAsync(request, currentUserId);
            docUploadTitle = "";
            docUploadFile = null;
            await OpenDocumentsPanel(selectedTaskForDocuments);
        }
        catch (Exception ex)
        {
            docUploadError = ex.Message;
        }
        finally
        {
            isDocUploading = false;
        }
    }

    private async Task AttachExistingDocumentAsync()
    {
        if (selectedTaskForDocuments?.ProjectId == null || attachDocumentId == null)
        {
            attachError = "This task has no project to attach documents to.";
            return;
        }

        var success = await DocumentService.AttachToProjectAsync(attachDocumentId.Value, selectedTaskForDocuments.ProjectId.Value, currentUserId);
        if (!success)
        {
            attachError = "Unable to attach this document.";
            return;
        }

        attachDocumentId = null;
        await OpenDocumentsPanel(selectedTaskForDocuments);
    }

    private string GetPriorityColor(TaskPriority priority)
    {
        return priority switch
        {
            TaskPriority.Critical => "danger",
            TaskPriority.High => "warning",
            TaskPriority.Medium => "info",
            TaskPriority.Low => "secondary",
            _ => "secondary"
        };
    }
}
